{
  "manifest_version": 3,
  "name": "Google Photos Remover",
  "short_name": "PhotoRemover",
  "version": "0.2.0",
  "version_name": "0.2.0",
  "description": "Bulk-delete Google Photos in one click. Fast, private batches with all processing kept in your browser",
  "homepage_url": "https://github.com/Sajedur0/Google-Photos-Remover",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "src/assets/icons/icon_16x16.png",
    "32": "src/assets/icons/icon_32x32.png",
    "48": "src/assets/icons/icon_48x48.png",
    "128": "src/assets/icons/icon_128x128.png"
  },
  "action": {
    "default_title": "Google Photos Remover",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon_16x16.png",
      "32": "src/assets/icons/icon_32x32.png",
      "48": "src/assets/icons/icon_48x48.png",
      "128": "src/assets/icons/icon_128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "include_globs": [
        "*delete_all*"
      ],
      "js": [
        "src/content/delete-photos.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
